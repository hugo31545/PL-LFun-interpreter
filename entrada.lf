-- ============================================================
-- Ficheiro de teste: entrada.lf
-- LFun — Linguagem Funcional
-- ============================================================

-- A. Expressões aritméticas e booleanas
3 + 4;
10 - 2 * 3;
(8 + 2) * 5;
3 < 5;
10 == 7;
(4 + 1) == 5;

-- B. Definições de valores
let base : Int = 10;
let ativo : Bool = true;
let area : Int = 4 * 5;

let largura : Int = 8;
let altura : Int = 5;
let areaRect : Int = largura * altura;
areaRect;

-- C. Funções simples
fun inc : Int -> Int;
let inc x = x + 1;
inc(5);

fun dobro : Int -> Int;
let dobro n = n * 2;
dobro(7);

-- D. Condicional e When (Int/Bool)
fun absoluto : Int -> Int;
let absoluto n = if n < 0 then 0 - n else n;
absoluto(-5);

fun eZero : Int -> Bool;
let eZero n =
  when (n) is
    0 -> true;
    _ -> false;
  end;
eZero(0);

fun boolToInt : Bool -> Int;
let boolToInt b =
  when b is
    true  -> 1;
    false -> 0;
  end;
boolToInt(true);

-- E. Recursividade
fun fatorial : Int -> Int;
let fatorial n = 
    if n == 0 then 1 
    else n * fatorial(n - 1);

fatorial(5);
fatorial(6);

-- F. Tipo Char
let grade : Char = 'A';
fun describeGrade : Char -> String;
let describeGrade g =
    when g is
        'A' -> "Excelente";
        'B' -> "Bom";
        'C' -> "Suficiente";
        _   -> "Reprovado";
    end;

describeGrade('A');
describeGrade('B');
describeGrade('F');

-- G. Tipo String e Concatenação
let saudacao : String = "Ola, ";
let nome : String = "Mundo";
let mensagem : String = saudacao + nome;
mensagem;

fun welcome : String -> String;
let welcome n = "Bem-vindo, " + n + "!";
welcome("Jose");

-- H. Quando com Strings
fun checkSecret : String -> Bool;
let checkSecret s =
    when s is
        "lfun2026" -> true;
        _          -> false;
    end;

checkSecret("errado");
checkSecret("lfun2026");

-- I. Operadores Lógicos
let logicTest : Bool = (true || false) && (!false);
logicTest;
